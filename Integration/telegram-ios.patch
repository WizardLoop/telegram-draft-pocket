@@ -53,6 +53,29 @@ private func chatInputRunsCollectingUnresolvedCustomEmoji(_ runs: [ChatInputRun]
 }
 
 extension ChatInputContent {
+    /// Full file objects are stored alongside Draft Pocket's canonical model, whose codec
+    /// intentionally persists emoji ids only. Walk nested buttons and every block's runs.
+    func draftPocketCustomEmojiFiles() -> [Int64: TelegramMediaFile] {
+        var result: [Int64: TelegramMediaFile] = [:]
+        func collect(_ runs: [ChatInputRun]) {
+            for run in runs {
+                switch run.attributes.entity {
+                case let .customEmoji(fileId, file, _):
+                    if let file = file { result[fileId] = file }
+                case let .button(button):
+                    collect(button.label)
+                case .mention, .url, .date, .none:
+                    break
+                }
+            }
+        }
+        _ = self.mappingRuns { runs in
+            collect(runs)
+            return runs
+        }
+        return result
+    }
+
     /// Rebuilds every block with its runs transformed. The `switch` is EXHAUSTIVE (no `default`) on
     /// purpose: a new `ChatInputBlock` case must state where its runs live, rather than silently
     /// carrying emoji that never resolve.
